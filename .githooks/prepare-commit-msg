set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

args=(
  prepare-commit-msg
  --message-file "$1"
)

if [[ $# -ge 2 ]]; then
  args+=(--source "$2")
fi

if [[ $# -ge 3 ]]; then
  args+=(--commit-sha "$3")
fi

python3 "$repo_root/tools/versioning.py" "${args[@]}"
