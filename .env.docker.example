# Docker compose service settings
OPSATLAS_DB_NAME=opsatlas
OPSATLAS_DB_USER=opsatlas
OPSATLAS_DB_PASSWORD=change_me_postgres_password
OPSATLAS_API_PORT=8000
OPSATLAS_WEB_PORT=3000

# Browser-visible API URL baked into the Flutter web image.
# If you expose the API through a public hostname or tunnel, set this to that
# external URL; the backend will automatically trust this primary API hostname.
# Rebuild the `web` image after changing this value.
OPSATLAS_PUBLIC_API_BASE_URL=http://localhost:8000

# Application runtime settings inside containers
APP_ENV=container
APP_NAME=OpsAtlas
DB_ECHO=false
AUTO_CREATE_TABLES=false

JWT_SECRET=change_me_long_random
JWT_ISSUER=OpsAtlas
JWT_AUDIENCE=OpsAtlas-client
ACCESS_TOKEN_MINUTES=240
REFRESH_TOKEN_DAYS=14

# Add browser origins here when the web UI is served from additional domains.
# Native clients do not use CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Extra backend hostnames beyond localhost and OPSATLAS_PUBLIC_API_BASE_URL.
# Add any additional reverse-proxy, direct-LAN, or alternate DNS names here.
TRUSTED_HOSTS=localhost,127.0.0.1

AI_ENABLED=true
AI_PROVIDER=heuristic
AI_RATE_LIMIT_PER_MINUTE=30
AI_MAX_INPUT_CHARS=12000
AI_SUMMARY_CHAR_LIMIT=400

MEDIA_MAX_UPLOAD_MB=25
MEDIA_TOKEN_TTL_SECONDS=3600
MEDIA_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,pdf,txt,md,csv,json,zip,docx,xlsx,pptx,mp4,webm,mov,m4v,mp3,wav,ogg,m4a
MEDIA_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,text/markdown,text/csv,application/json,application/zip,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,video/mp4,video/webm,video/quicktime,audio/mpeg,audio/wav,audio/ogg,audio/x-m4a
MEDIA_BLOCKED_EXTENSIONS=html,htm,svg,svgz,js,mjs,xhtml
MEDIA_BLOCKED_MIME_TYPES=text/html,application/xhtml+xml,image/svg+xml,application/javascript,text/javascript
MEDIA_MALWARE_SCAN_ENABLED=false
MEDIA_MALWARE_SCAN_COMMAND=

BACKGROUND_WORKERS_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=300
HSTS_MAX_AGE_SECONDS=63072000

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_BASE_SECONDS=60
AUTH_LOGIN_LOCKOUT_MAX_SECONDS=1800
AUTH_IP_RATE_LIMIT_PER_MINUTE=60
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=30

PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=true
PASSWORD_COMPROMISED_CHECK_ENABLED=true
PASSWORD_ENFORCE_IN_DEV=false

MFA_ENABLED=true
MFA_ENFORCE_IN_DEV=false
MFA_TOTP_WINDOW=1
MFA_TOTP_ISSUER=OpsAtlas

AUTH_COOKIE_ACCESS_NAME=opsatlas_access
AUTH_COOKIE_REFRESH_NAME=opsatlas_refresh
AUTH_COOKIE_SESSION_NAME=opsatlas_session
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=lax

# Set this to true behind HTTPS/TLS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SECURE_IN_DEV=false

# Replace this with one or more real URL-safe base64 32-byte keys.
SECRET_ENCRYPTION_KEYS=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional container boot timing overrides
WAIT_FOR_DB_TIMEOUT_SECONDS=90
WAIT_FOR_DB_INTERVAL_SECONDS=2
