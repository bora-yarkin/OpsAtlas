{
  "include": [
    "app",
    "scripts",
    "alembic"
  ],
  "exclude": [
    "**/node_modules",
    "**/.*",
    "**/__pycache__",
    "**/.venv",
    "**/build",
    "**/dist",
    "alembic/versions"
  ],
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        "."
      ]
    }
  ],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.11"
}
